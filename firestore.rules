rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Reads the caller's own profile to check their role.
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // Boss by explicit role OR by the "Trưởng CA" chức vụ (position alone grants
    // boss permissions). Keep the literal in sync with BOSS_POSITION in the app.
    function isBoss() {
      return isSignedIn()
        && (myProfile().role == 'boss'
            || myProfile().get('position', '') == 'Trưởng CA');
    }
    // `dev` is a review/demo role: staff-like features PLUS user approval.
    function isDev() {
      return isSignedIn() && myProfile().role == 'dev';
    }
    // May manage (read/approve/deactivate/delete) other user accounts.
    function isManager() {
      return isBoss() || isDev();
    }
    function isApprovedStaff() {
      return isSignedIn()
        && myProfile().role == 'staff'
        && myProfile().approved == true
        && myProfile().active == true;
    }
    // May write their own plan entries (approved staff, or a dev account).
    function canRegister() {
      return isApprovedStaff() || isDev();
    }

    // True when the given path parts (VN local day keys) are TODAY in
    // Asia/Ho_Chi_Minh (UTC+7, no DST). Used to let staff see everyone's
    // registrations for the current day, but not for past days.
    function isTodayVN(year, month, day) {
      let vn = request.time + duration.value(7, 'h');
      return int(year) == vn.year()
        && int(month) == vn.month()
        && int(day) == vn.day();
    }

    // ---- app config (version gating) ----
    // Public read: the force-update gate must read config/app before sign-in.
    // Only holds non-sensitive values (forceUpdate, minVersion, latestVersion,
    // updateUrl, message). Write via the Firebase console / admin only — no
    // in-app client may modify it.
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ---- users ----
    match /users/{uid} {
      // A user can read their own profile; a manager (boss/dev) reads everyone.
      // Any signed-in user may also read a "Trưởng CA" profile — used to detect
      // whether a Trưởng CA already exists (so the option can be hidden). This
      // only exposes the commander's profile, which is not sensitive here.
      allow read: if isSignedIn()
        && (request.auth.uid == uid
            || isManager()
            || resource.data.get('position', '') == 'Trưởng CA');

      // New users create their own profile, but cannot self-approve or make
      // themselves a boss. They start active but unapproved.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'staff'
        && request.resource.data.approved == false
        && request.resource.data.active == true;

      // A manager (boss/dev) may update anyone (e.g. to approve or deactivate).
      // A user may update their own profile but NEVER their `active` flag, and
      // their `role`/`approved` must follow their chức vụ:
      //   - "Trưởng CA"  ⇒ role must be 'boss' AND approved must be true
      //                    (picking this chức vụ self-promotes + auto-approves).
      //   - any other    ⇒ role must be 'staff' AND approved unchanged
      //                    (no self-approval, no self-granting dev/boss).
      // A `dev` account is exempt (keeps its role/approved unchanged).
      allow update: if isManager()
        || (request.auth.uid == uid
            && request.resource.data.active == resource.data.active
            && (
                 (resource.data.role == 'dev'
                  && request.resource.data.role == 'dev'
                  && request.resource.data.approved == resource.data.approved)
                 ||
                 (request.resource.data.role ==
                    (request.resource.data.get('position', '') == 'Trưởng CA'
                      ? 'boss' : 'staff')
                  && request.resource.data.approved ==
                    (request.resource.data.get('position', '') == 'Trưởng CA'
                      ? true : resource.data.approved))
               ));

      // A manager may delete anyone; a user may delete their own account.
      allow delete: if isManager() || request.auth.uid == uid;
    }

    // ---- plan history: history/{year}/months/{month}/days/{day}/entries/{uid}
    // Rule A (recursive wildcard) also covers collectionGroup('entries') — the
    // staff "own history" query. It grants: boss → all; staff → own (any day).
    match /{path=**}/entries/{uid} {
      // Own entries (any day), for both `get` and collectionGroup queries:
      //  - doc-id branch (request.auth.uid == uid): allows a `get` on a
      //    not-yet-created entry (resource == null) without erroring, since the
      //    entry doc id is always the owner's uid.
      //  - field branch (resource.data.uid ...): lets the "own history"
      //    collectionGroup('entries').where('uid','==', me) query pass the
      //    Firestore query-rules analysis (which matches on the field, not the
      //    doc id).
      allow read: if isManager()
        || (isSignedIn() && request.auth.uid == uid)
        || (isSignedIn() && resource != null && resource.data.uid == request.auth.uid);

      // Approved staff (or a dev account) may write only their own entry.
      allow write: if canRegister()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid;
    }

    // Rule B: approved staff may additionally READ everyone's entries for the
    // CURRENT day (the "đăng ký công tác hôm nay" coordination view). Past days
    // stay private — a query on an older day's entries is denied for staff, so
    // the History screen cannot see other users. (Rules are additive: a doc is
    // readable if Rule A OR Rule B allows it.)
    match /history/{year}/months/{month}/days/{day}/entries/{uid} {
      allow read: if (isApprovedStaff() || isDev()) && isTodayVN(year, month, day);
    }
  }
}
