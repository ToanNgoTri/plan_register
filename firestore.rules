rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Reads the caller's own profile to check their role.
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // Boss by explicit role OR by the "Trưởng CA" chức vụ (position alone grants
    // boss permissions). Keep the literal in sync with BOSS_POSITION in the app.
    function isBoss() {
      return isSignedIn()
        && (myProfile().role == 'boss'
            || myProfile().get('position', '') == 'Trưởng CA');
    }
    // `dev` is a review/demo role: staff-like features PLUS user approval.
    function isDev() {
      return isSignedIn() && myProfile().role == 'dev';
    }
    // May manage (read/approve/deactivate/delete) other user accounts.
    function isManager() {
      return isBoss() || isDev();
    }
    function isApprovedStaff() {
      return isSignedIn()
        && myProfile().role == 'staff'
        && myProfile().approved == true
        && myProfile().active == true;
    }
    // May write their own plan entries (approved staff, or a dev account).
    function canRegister() {
      return isApprovedStaff() || isDev();
    }
    // May read AND post the duty roster (lịch trực). Deliberately everyone with
    // access to the app: approved staff, the boss, and the dev account. Keep in
    // sync with canUseDuty() in storage.rules.
    function canUseDuty() {
      return isApprovedStaff() || isManager();
    }

    // May read the sổ số văn bản and take a number. Same audience as the duty
    // roster: everyone with access to the app.
    function canUseDocNumbers() {
      return isApprovedStaff() || isManager();
    }
    // The caller currently holds the (unexpired) "đang nhập" lock. Used to gate
    // the counter, so a number can only be issued by whoever holds the book.
    function holdsDocNumberLock() {
      let lock = get(/databases/$(database)/documents/doc_number_locks/global);
      return lock != null
        && lock.data.uid == request.auth.uid
        && lock.data.expiresAt > request.time.toMillis();
    }
    // The lock document being written over has already expired (its holder's
    // app died without releasing it), so anyone may take or clear it.
    function lockExpired() {
      return resource.data.expiresAt <= request.time.toMillis();
    }

    // True when the given path parts (VN local day keys) are TODAY in
    // Asia/Ho_Chi_Minh (UTC+7, no DST). Used to let staff see everyone's
    // registrations for the current day, but not for past days.
    function isTodayVN(year, month, day) {
      let vn = request.time + duration.value(7, 'h');
      return int(year) == vn.year()
        && int(month) == vn.month()
        && int(day) == vn.day();
    }

    // ---- app config (version gating) ----
    // Public read: the force-update gate must read config/app before sign-in.
    // Only holds non-sensitive values (forceUpdate, minVersion, latestVersion,
    // updateUrl, message). Write via the Firebase console / admin only — no
    // in-app client may modify it.
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ---- users ----
    match /users/{uid} {
      // A user can read their own profile; a manager (boss/dev) reads everyone.
      // Any signed-in user may also read a "Trưởng CA" profile — used to detect
      // whether a Trưởng CA already exists (so the option can be hidden). This
      // only exposes the commander's profile, which is not sensitive here.
      allow read: if isSignedIn()
        && (request.auth.uid == uid
            || isManager()
            || resource.data.get('position', '') == 'Trưởng CA');

      // New users create their own profile, but cannot self-approve or make
      // themselves a boss. They start active but unapproved.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'staff'
        && request.resource.data.approved == false
        && request.resource.data.active == true;

      // A manager (boss/dev) may update anyone (e.g. to approve or deactivate).
      // A user may update their own profile but NEVER their `active` flag, and
      // their `role`/`approved` must follow their chức vụ:
      //   - "Trưởng CA"  ⇒ role must be 'boss' AND approved must be true
      //                    (picking this chức vụ self-promotes + auto-approves).
      //   - any other    ⇒ role must be 'staff' AND approved unchanged
      //                    (no self-approval, no self-granting dev/boss).
      // A `dev` account is exempt (keeps its role/approved unchanged).
      allow update: if isManager()
        || (request.auth.uid == uid
            && request.resource.data.active == resource.data.active
            && (
                 (resource.data.role == 'dev'
                  && request.resource.data.role == 'dev'
                  && request.resource.data.approved == resource.data.approved)
                 ||
                 (request.resource.data.role ==
                    (request.resource.data.get('position', '') == 'Trưởng CA'
                      ? 'boss' : 'staff')
                  && request.resource.data.approved ==
                    (request.resource.data.get('position', '') == 'Trưởng CA'
                      ? true : resource.data.approved))
               ));

      // A manager may delete anyone; a user may delete their own account.
      allow delete: if isManager() || request.auth.uid == uid;
    }

    // ---- duty roster: duty_schedules/{force} ----
    // One CURRENT roster per lực lượng ('CA' / 'ANCS'); posting a new one
    // overwrites the doc (no history is kept). Anyone with app access may post,
    // so `uploadedBy` is forced to the caller — the roster always shows who put
    // it there. Deleting is narrower: only the person who posted it, or a
    // manager, so a stray tap cannot wipe someone else's roster.
    match /duty_schedules/{force} {
      allow read: if canUseDuty();
      allow create, update: if canUseDuty()
        && force in ['CA', 'ANCS']
        && request.resource.data.force == force
        && request.resource.data.uploadedBy == request.auth.uid;
      allow delete: if isManager()
        || (canUseDuty() && resource.data.uploadedBy == request.auth.uid);
    }

    // ---- sổ số văn bản ----
    // Cùng nhóm người dùng với lịch trực: cán bộ đã duyệt + boss + dev.
    //
    //  doc_numbers/{id}            – văn bản đã được cấp số (sổ gốc)
    //  doc_number_counters/{id}    – { next } : số sẽ cấp tiếp cho một loại/năm
    //  doc_number_locks/global     – ai đang mở form lấy số
    match /doc_numbers/{id} {
      allow read: if canUseDocNumbers();
      // `createdBy` bị ép về chính người gọi: sổ luôn truy được ai lấy số.
      allow create: if canUseDocNumbers()
        && request.resource.data.createdBy == request.auth.uid;
      // Sổ số văn bản là sổ gốc: đã cấp thì không sửa, không xoá — sửa số đã
      // phát hành ra ngoài sẽ làm lệch cả dãy số. Cần bỏ một số thì huỷ bằng
      // Firebase console (admin), có vết rõ ràng.
      allow update, delete: if false;
    }

    // Bộ đếm chỉ được TĂNG DẦN từng một đơn vị, và chỉ bởi người đang giữ
    // khoá — chặn cả việc lùi số (cấp trùng) lẫn việc nhảy cóc số.
    match /doc_number_counters/{id} {
      allow read: if canUseDocNumbers();
      allow create: if canUseDocNumbers()
        && holdsDocNumberLock()
        && request.resource.data.next == 2;
      allow update: if canUseDocNumbers()
        && holdsDocNumberLock()
        && request.resource.data.next == resource.data.next + 1;
      allow delete: if false;
    }

    // Bộ đếm chữ phụ của MỘT số cụ thể (12A, 12B...). Cùng luật với bộ đếm
    // chính: chỉ người đang giữ khoá được tăng, và chỉ tăng đúng một đơn vị —
    // lùi lại là cấp trùng chữ, nhảy cóc là mất chữ.
    match /doc_number_suffixes/{id} {
      allow read: if canUseDocNumbers();
      allow create: if canUseDocNumbers()
        && holdsDocNumberLock()
        && request.resource.data.next == 2;
      allow update: if canUseDocNumbers()
        && holdsDocNumberLock()
        && request.resource.data.next == resource.data.next + 1;
      allow delete: if false;
    }

    // Danh mục người ký / đơn vị ban hành. Cả đơn vị đọc để đổ vào dropdown,
    // nhưng chỉ quản lý (Trưởng CA / dev) mới sửa được — đây là dữ liệu dùng
    // chung, một người sửa là cả đơn vị thấy.
    match /doc_number_options/{id} {
      allow read: if canUseDocNumbers();
      allow write: if isManager()
        && id == 'lists'
        && request.resource.data.signers is list
        && request.resource.data.units is list;
    }

    // Khoá nhập liệu. Chỉ giành được khi khoá đang trống, đã hết hạn, hoặc là
    // khoá của chính mình (gia hạn); và khoá ghi ra luôn mang tên người gọi,
    // nên không ai giả danh người khác "đang nhập" được. Nhả khoá thì rộng
    // hơn: chủ khoá, quản lý (gỡ kẹt), hoặc bất kỳ ai khi khoá đã hết hạn.
    match /doc_number_locks/{id} {
      allow read: if canUseDocNumbers();
      allow create: if canUseDocNumbers()
        && request.resource.data.uid == request.auth.uid;
      allow update: if canUseDocNumbers()
        && request.resource.data.uid == request.auth.uid
        && (resource.data.uid == request.auth.uid || lockExpired());
      allow delete: if isManager()
        || (canUseDocNumbers()
            && (resource.data.uid == request.auth.uid || lockExpired()));
    }

    // ---- plan history: history/{year}/months/{month}/days/{day}/entries/{uid}
    // Rule A (recursive wildcard) also covers collectionGroup('entries') — the
    // staff "own history" query. It grants: boss → all; staff → own (any day).
    match /{path=**}/entries/{uid} {
      // Own entries (any day), for both `get` and collectionGroup queries:
      //  - doc-id branch (request.auth.uid == uid): allows a `get` on a
      //    not-yet-created entry (resource == null) without erroring, since the
      //    entry doc id is always the owner's uid.
      //  - field branch (resource.data.uid ...): lets the "own history"
      //    collectionGroup('entries').where('uid','==', me) query pass the
      //    Firestore query-rules analysis (which matches on the field, not the
      //    doc id).
      allow read: if isManager()
        || (isSignedIn() && request.auth.uid == uid)
        || (isSignedIn() && resource != null && resource.data.uid == request.auth.uid);

      // Approved staff (or a dev account) may write only their own entry.
      allow write: if canRegister()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid;
    }

    // Rule B: approved staff may additionally READ everyone's entries for the
    // CURRENT day (the "đăng ký công tác hôm nay" coordination view). Past days
    // stay private — a query on an older day's entries is denied for staff, so
    // the History screen cannot see other users. (Rules are additive: a doc is
    // readable if Rule A OR Rule B allows it.)
    match /history/{year}/months/{month}/days/{day}/entries/{uid} {
      allow read: if (isApprovedStaff() || isDev()) && isTodayVN(year, month, day);
    }
  }
}
