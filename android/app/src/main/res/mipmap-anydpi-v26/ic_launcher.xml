<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon cho Android 8 trở lên: launcher tự cắt theo hình của máy
  (tròn, vuông bo góc, giọt nước...). Không có file này thì Android bọc icon
  vuông vào một nền trắng rồi thu nhỏ lại, nhìn rất xấu trên máy đời mới.
  Android 7 trở xuống bỏ qua thư mục -v26 và dùng ic_launcher.png như cũ.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
